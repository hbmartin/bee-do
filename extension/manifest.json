{
  "manifest_version": 3,
  "name": "Bee-do Capture",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Describe and mark up a page, then deliver the capture to Slack.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://trellium.ai/*",
    "https://*.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*.workers.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Capture this page with Bee-do" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://trellium.ai/*", "https://*.vercel.app/*"],
      "js": ["collector.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://trellium.ai/*", "https://*.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["https://trellium.ai/*", "https://*.vercel.app/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Capture this page"
    }
  }
}
